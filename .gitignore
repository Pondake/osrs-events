# Per-developer Claude Code settings — shared config lives in CLAUDE.md
# and .claude/commands/, both of which are tracked.
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db

# Old NestJS + Nuxt stack, kept on disk for reference during the Laravel
# migration (see docs/backlog.md) but not tracked — a full second stack's
# node_modules/vendor/lockfiles have no business bloating this repo's history.
/stale/

# Laravel (moved here from laravel-app/ — see docs/backlog.md)
*.log
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.phpunit.cache
/auth.json
/node_modules
/public/build
/bootstrap/ssr
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml

# Auto-generated by laravel-vue-i18n's Vite plugin from lang/*.php files at
# dev/build time — never a source file, per the package's own README.
lang/php_*.json

# Editor/LSP scratch files the framework directory collects.
/storage/framework/lsp-*.php

# Facts about the owner's own Discord server — channel and role ids, invite
# links, who is who. Useful to keep next to the code and not something to
# publish with it, so it lives on disk and out of the repo.
/docs/discord.md
