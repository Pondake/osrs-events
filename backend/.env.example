# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres@localhost:5432/osrs_snakes"

# ──────────────────────────────────────────────
# Discord OAuth2
# ──────────────────────────────────────────────
# Step-by-step to get Client ID + Secret:
#
# 1. Go to https://discord.com/developers/applications
# 2. Click "New Application" → give it a name (e.g. "OSRS Snakes & Ladders") → Create
# 3. In the LEFT SIDEBAR, click "OAuth2"
#    ⚠️  NOT "General Information" — that page shows App ID + Public Key (different things)
# 4. On the OAuth2 page:
#    - "CLIENT ID" → copy and paste as DISCORD_CLIENT_ID below
#    - "CLIENT SECRET" → click "Reset Secret" → copy and paste as DISCORD_CLIENT_SECRET below
#    - Under "Redirects", click "Add Redirect" and enter:
#      http://localhost:3001/auth/discord/callback   ← note: port 3001 (BACKEND), not 3000
#    - Click "Save Changes"
#
# Note: The "App ID" shown on the General Information page is the same as the Client ID.
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
# ⚠️  Must match the Redirect URL you registered in Discord Developer Portal → OAuth2
#     This always points to the BACKEND (port 3001), NOT the Nuxt frontend (port 3000)
DISCORD_CALLBACK_URL=http://localhost:3001/auth/discord/callback

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY=7d

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
# PORT = port this NestJS backend listens on (default: 3001)
PORT=3001

# NUXT_APP_URL = URL where the Nuxt frontend runs (default: http://localhost:3000)
# The backend uses this to:
#   1. Allow CORS requests from the frontend
#   2. Redirect the user back to the frontend after Discord login completes
#
# OAuth2 flow summary:
#   Frontend (3000) → clicks "Login with Discord"
#   → navigates to Backend (3001) /auth/discord
#   → Backend redirects to Discord's OAuth page
#   → Discord redirects back to Backend (3001) /auth/discord/callback
#   → Backend issues JWT and redirects to Frontend (3000) /auth/callback?token=...
NUXT_APP_URL=http://localhost:3000
