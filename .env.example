APP_NAME="OSRS Events"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# `artisan serve` handles one request at a time. That matters here: every
# event type has a live channel (/events/{event}/stream) that holds its
# worker for ~45 seconds, so ONE open event page blocks the whole dev
# server — a second stream never even connects. This setting helps on
# Linux/macOS and only together with --no-reload; it forks, so on Windows it
# does nothing at all. Serve through Herd/Valet/nginx+fpm when working on
# any live page.
PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset locally (plain HTTP dev server). MUST be true in any real
# deployment — an unset/false secure flag lets the session cookie (and the
# XSRF-TOKEN cookie fetch() calls read for CSRF) travel over plain HTTP.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound mail. One thing sends it today — the password-reset link for
# email/password accounts (Discord logins never need it) — and that one
# thing fails SILENTLY when this is wrong: `log` writes the reset mail to
# storage/logs/laravel.log and reports success to the user, who then waits
# for an email that was never sent. `log` is right for local work and wrong
# for every deployment.
#
# Brevo (https://brevo.com) is the intended provider: 300 mails/day free
# with no expiry, EU-hosted, and it speaks plain SMTP — so it needs no
# package and no code, only the values below. Generate the key under
# Transactional → Settings → Configuration → SMTP relay.
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587             # STARTTLS; 465 works too, with MAIL_SCHEME=smtps
#   MAIL_SCHEME=smtp
#   MAIL_USERNAME=<your Brevo login email>
#   MAIL_PASSWORD=<the generated SMTP key, NOT your account password>
#
# Swapping providers is an env change, not a code change: `ses`, `postmark`
# and `resend` are built into Laravel (keys go in config/services.php, and
# `resend` additionally needs `composer require resend/resend-laravel`).
# Worth doing only when volume outgrows the free tier — see README.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# The From address, and the one setting here with no working default. It
# must be an address at a domain you have verified with the provider —
# an unverified From is rejected outright or lands in spam, and
# `hello@example.com` is neither.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Discord OAuth2 — the only login path. Register an app at
# https://discord.com/developers/applications, then set the Redirect URL
# there to match DISCORD_REDIRECT_URI below exactly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

# Wise Old Man (https://wiseoldman.net) — where skill-race standings come
# from. Nothing needs configuring for it to work, but they ask API consumers
# to identify themselves, so set a User-Agent with a contact address you
# actually read. An API key is optional and only raises the rate limit from
# 20 to 100 requests a minute.
WOM_USER_AGENT="osrs-events (contact: you@example.com)"
WOM_API_KEY=
# Paces outbound requests against their rate limit. Only ever turned off
# where the API is faked (phpunit.xml sets it) — the limit is theirs.
WOM_THROTTLE=true

# Local-only admin test account — lets you (and anyone with a checkout of
# this repo) exercise admin-only pages without real Discord credentials.
# Fill both in, then run `php artisan db:seed` (AdminUserSeeder picks up
# ADMIN_USER) and visit /dev-login?as=admin&pass=<ADMIN_PASS>.
# Only reachable when APP_ENV=local — see routes/web.php.
ADMIN_USER=
ADMIN_PASS=

