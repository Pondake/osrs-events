APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset locally (plain HTTP dev server). MUST be true in any real
# deployment — an unset/false secure flag lets the session cookie (and the
# XSRF-TOKEN cookie fetch() calls read for CSRF) travel over plain HTTP.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Discord OAuth2 — the only login path. Register an app at
# https://discord.com/developers/applications, then set the Redirect URL
# there to match DISCORD_REDIRECT_URI below exactly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

# Local-only admin test account — lets you (and anyone with a checkout of
# this repo) exercise admin-only pages without real Discord credentials.
# Fill both in, then run `php artisan db:seed` (AdminUserSeeder picks up
# ADMIN_USER) and visit /dev-login?as=admin&pass=<ADMIN_PASS>.
# Only reachable when APP_ENV=local — see routes/web.php.
ADMIN_USER=
ADMIN_PASS=

# Donation link, used by every "support" button on the site. Must be the
# full profile URL (https://ko-fi.com/<name>) — the bare domain just lands
# people on Ko-fi's homepage with no way to reach the right account.
KOFI_URL=
